{
  "name": "farmared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.7.0"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:wait": "node --env-file-if-exists=.env scripts/wait.js",
    "db:schema": "node --env-file-if-exists=.env scripts/schema.js",
    "graph:schema": "node --env-file-if-exists=.env scripts/graph-schema.js",
    "graph:load": "node --env-file-if-exists=.env scripts/graph-load.js",
    "data:check": "node --env-file-if-exists=.env scripts/check-data.js",
    "data:load": "node --env-file-if-exists=.env scripts/load.js",
    "query": "node --env-file-if-exists=.env scripts/query.js",
    "outbox:procesar": "node --env-file-if-exists=.env scripts/outbox.js procesar",
    "outbox:estado": "node --env-file-if-exists=.env scripts/outbox.js estado",
    "demo:q14": "node --env-file-if-exists=.env scripts/demo-q14.js",
    "demo:consultas": "node --env-file-if-exists=.env scripts/demo-consultas.js",
    "demo:q13": "node --env-file-if-exists=.env scripts/demo-q13.js",
    "demo:outbox": "node --env-file-if-exists=.env scripts/demo-outbox.js",
    "demo:q15": "node --env-file-if-exists=.env scripts/demo-q15.js",
    "demo:grafo": "node --env-file-if-exists=.env scripts/demo-grafo.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integration/*.test.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write \"**/*.{js,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,yaml,yml}\""
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "mongodb": "6.20.0",
    "neo4j-driver": "5.28.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  }
}
