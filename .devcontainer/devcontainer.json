{
  "name": "FarmaRed",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "runServices": ["mongo", "mongo-init", "neo4j", "app"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "npm ci && npm run db:wait && npm run db:schema",
  "forwardPorts": ["neo4j:7474"],
  "portsAttributes": {
    "7474": {
      "label": "Neo4j",
      "visibility": "private"
    }
  }
}
